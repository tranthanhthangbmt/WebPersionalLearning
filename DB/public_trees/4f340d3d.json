        {
            "id": "c1.1",
            "parent_macro": "m1",
            "title": "Bài 1: Lịch sử và cuộc sống",
            "content": "Tìm hiểu khái niệm cơ bản về lịch sử và môn lịch sử học gì. Giải thích vì sao cần thiết phải tìm hiểu và học tập lịch sử đối với mỗi con người. Giúp học sinh bước đầu nhận thức được mối liên hệ chặt chẽ giữa quá khứ, hiện tại và tương lai.",
            "alpha_base": 12,
            "bloom_profile": {
                "auto_calibrated_levels": [
                    1,
                    2
                ],
                "user_adjusted_levels": null,
                "effective_levels": [
                    1,
                    2
                ],
                "calibration_method": "alpha_base",
                "alpha_base": 12,
                "created_at": "2026-05-31T21:04:24.765669"
            }
        },
        {
            "id": "c1.2",
            "parent_macro": "m1",
            "title": "Bài 2: Dựa vào đâu để biết và phục dựng lại lịch sử?",
            "content": "Giới thiệu các nguồn tư liệu lịch sử chính bao gồm tư liệu truyền miệng, hiện vật và chữ viết. Hướng dẫn cách thức nhận diện và khai thác giá trị của từng loại tư liệu để dựng lại quá khứ một cách chân thực nhất. Giúp học sinh hiểu được phương pháp nghiên cứu lịch sử cơ bản.",
            "alpha_base": 18,
            "bloom_profile": {
                "auto_calibrated_levels": [
                    1,
