        {
            "id": "c2.2",
            "parent_macro": "m2",
            "title": "Bài 5: Xã hội nguyên thủy",
            "content": "Khái quát sự chuyển biến về đời sống vật chất, tinh thần cũng như tổ chức xã hội thời nguyên thủy từ bầy người sang thị tộc, bộ lạc. Mô tả chi tiết cách thức người nguyên thủy chế tạo công cụ, phát minh ra lửa và thực hiện hái lượm, săn bắn. Làm rõ những biểu hiện sơ khai của đời sống tâm linh, nghệ thuật.",
            "alpha_base": 14,
            "bloom_profile": {
