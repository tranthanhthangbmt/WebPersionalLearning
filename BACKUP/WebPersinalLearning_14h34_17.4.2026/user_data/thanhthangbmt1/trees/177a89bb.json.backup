    "micro_nodes": [
        {
            "id": "c1.1",
            "parent_macro": "m1",
            "title": "Khái niệm chung về TMĐT",
            "content": "Bài học này giới thiệu các định nghĩa cơ bản về Thương mại điện tử (TMĐT). Sinh viên sẽ hiểu được vai trò và tầm quan trọng của TMĐT trong kinh doanh hiện đại. Đồng thời, bài học cung cấp cái nhìn tổng quan về lĩnh vực đang phát triển mạnh mẽ này.",
            "alpha_base": 10
        },
        {
            "id": "c1.2",
            "parent_macro": "m1",
            "title": "Đặc điểm và phân loại TMĐT",
            "content": "Nội dung này mô tả các đặc điểm nổi bật của hoạt động TMĐT như tính toàn cầu, tương tác cao và chi phí thấp. Bài học cũng trình bày các cách phân loại TMĐT dựa trên đối tượng giao dịch hoặc hình thức hoạt động. Việc nắm vững các đặc điểm giúp hiểu rõ bản chất của TMĐT.",
            "alpha_base": 12
        },
        {
            "id": "c1.3",
            "parent_macro": "m1",
            "title": "Lợi ích và hạn chế của TMĐT",
            "content": "Bài học phân tích những ưu điểm mà TMĐT mang lại cho doanh nghiệp và người tiêu dùng, bao gồm mở rộng thị trường và tiết kiệm chi phí. Đồng thời, nó nêu rõ các thách thức và hạn chế tồn tại trong môi trường TMĐT. Sinh viên sẽ có cái nhìn đa chiều về lĩnh vực này.",
            "alpha_base": 15
        },
        {
            "id": "c1.4",
            "parent_macro": "m1",
            "title": "Sự phát triển của TMĐT và ảnh hưởng của TMĐT đến các lĩnh vực khác",
            "content": "Bài học tổng quan về lịch sử hình thành và các giai đoạn phát triển của TMĐT. Sinh viên sẽ đánh giá tác động của TMĐT đến các ngành nghề truyền thống, kinh tế, xã hội và văn hóa. Nội dung giúp hiểu bối cảnh và xu hướng phát triển của TMĐT.",
            "alpha_base": 15
        },
        {
            "id": "c1.5",
            "parent_macro": "m1",
            "title": "Cơ sở hạ tầng cho Thương mại điện tử",
            "content": "Nội dung này giới thiệu các yếu tố nền tảng cần thiết cho hoạt động TMĐT. Bao gồm hạ tầng pháp lý, công nghệ thông tin, thanh toán điện tử, an toàn thông tin, nhân lực và dịch vụ phân phối. Việc hiểu rõ các thành phần này là quan trọng để triển khai TMĐT hiệu quả.",
            "alpha_base": 13
        },
        {
            "id": "c1.6",
            "parent_macro": "m1",
            "title": "Các mô hình kinh doanh TMĐT",
            "content": "Bài học trình bày các mô hình TMĐT phổ biến như B2C (Doanh nghiệp – Người tiêu dùng), B2B (Doanh nghiệp – Doanh nghiệp), C2C (Cá nhân – Cá nhân) và C2B (Cá nhân – Doanh nghiệp). Sinh viên sẽ phân tích đặc điểm và ví dụ của từng mô hình, giúp lựa chọn mô hình phù hợp cho doanh nghiệp.",
            "alpha_base": 18
        },
        {
            "id": "c1.7",
            "parent_macro": "m1",
            "title": "Sàn giao dịch TMĐT",
            "content": "Nội dung này khái quát về sàn giao dịch điện tử, bao gồm định nghĩa, đặc trưng, phân loại và lợi ích. Bài học cũng nêu các phương thức giao dịch trên sàn TMĐT và quy trình đăng ký. Sinh viên sẽ hiểu cách hoạt động của các sàn giao dịch trực tuyến lớn.",
            "alpha_base": 17
        },
        {
            "id": "c2.1",
            "parent_macro": "m2",
            "title": "Hợp đồng điện tử",
            "content": "Bài học định nghĩa và phân tích đặc điểm của hợp đồng điện tử. Sinh viên sẽ nắm vững quy trình giao kết và thực hiện hợp đồng điện tử. Ngoài ra, bài học cũng đề cập đến những lưu ý quan trọng khi sử dụng loại hợp đồng này để đảm bảo tính pháp lý và an toàn.",
            "alpha_base": 18
        },
        {
            "id": "c2.2",
            "parent_macro": "m2",
            "title": "Thanh toán điện tử",
            "content": "Nội dung này giới thiệu khái niệm, yêu cầu của hệ thống thanh toán điện tử và phân biệt với thanh toán trong TMĐT. Bài học trình bày các phương thức thanh toán điện tử phổ biến hiện nay như ví điện tử, chuyển khoản trực tuyến. Sinh viên sẽ hiểu cơ chế hoạt động của các hình thức thanh toán số.",
            "alpha_base": 17
        },
        {
            "id": "c2.3",
            "parent_macro": "m2",
            "title": "Chữ ký số và chứng thực chữ ký số",
            "content": "Bài học giải thích đặc điểm, ưu điểm và quy trình sử dụng chữ ký số. Sinh viên sẽ hiểu rõ vai trò của dịch vụ chứng thực chữ ký số trong việc đảm bảo tính pháp lý và an toàn cho giao dịch điện tử. Nội dung này quan trọng trong việc xây dựng niềm tin trên môi trường số.",
            "alpha_base": 19
        },
        {
            "id": "c3.1",
            "parent_macro": "m3",
            "title": "Các khái niệm cơ bản về marketing điện tử",
            "content": "Bài học này giới thiệu các định nghĩa, vai trò và phạm vi của marketing điện tử. Sinh viên sẽ hiểu cách marketing truyền thống được điều chỉnh và mở rộng trong môi trường số. Đây là nền tảng để tiếp cận các công cụ marketing kỹ thuật số.",
            "alpha_base": 15
        },
        {
            "id": "c3.2",
            "parent_macro": "m3",
            "title": "Người tiêu dùng trong môi trường điện tử",
            "content": "Nội dung này phân tích hành vi, thói quen và đặc điểm của người tiêu dùng khi mua sắm và tương tác trực tuyến. Bài học nghiên cứu các yếu tố ảnh hưởng đến quyết định mua hàng của khách hàng số. Hiểu rõ khách hàng là chìa khóa để xây dựng chiến lược marketing hiệu quả.",
            "alpha_base": 18
        },
        {
            "id": "c3.3",
            "parent_macro": "m3",
            "title": "Nghiên cứu thị trường điện tử",
            "content": "Bài học trình bày các phương pháp và công cụ để nghiên cứu thị trường trong môi trường số. Sinh viên sẽ học cách thu thập, phân tích dữ liệu và hiểu rõ nhu cầu của khách hàng trực tuyến. Đây là kỹ năng cần thiết để đưa ra các quyết định kinh doanh chiến lược.",
            "alpha_base": 20
        },
        {
            "id": "c3.4",
            "parent_macro": "m3",
            "title": "Các công cụ marketing điện tử",
            "content": "Bài học giới thiệu các công cụ marketing điện tử phổ biến như SEO, social media marketing, email marketing, mobile marketing và content marketing. Sinh viên sẽ được hướng dẫn cách vận dụng các công cụ này vào dự án kinh doanh thực tế. Đây là phần ứng dụng quan trọng của môn học.",
            "alpha_base": 25
        },
        {
            "id": "c3.5",
            "parent_macro": "m3",
            "title": "Các vấn đề đo lường trong Marketing điện tử",
            "content": "Nội dung này trình bày các chỉ số và phương pháp đo lường hiệu quả của các chiến dịch marketing điện tử. Sinh viên sẽ giải thích cách phân tích dữ liệu để đánh giá ROI và tối ưu hóa hoạt động. Việc đo lường giúp cải thiện hiệu quả các chiến dịch marketing.",
            "alpha_base": 22
        },
        {
            "id": "c4.1",
            "parent_macro": "m4",
            "title": "Vấn đề an ninh trong TMĐT",
            "content": "Bài học nhận diện các vấn đề an ninh cốt lõi trong giao dịch TMĐT. Các vấn đề bao gồm bảo mật dữ liệu, quyền riêng tư và nguy cơ tấn công mạng. Hiểu rõ các mối đe dọa giúp doanh nghiệp và người dùng chủ động phòng tránh.",
            "alpha_base": 16
        },
        {
            "id": "c4.2",
            "parent_macro": "m4",
            "title": "Rủi ro trong TMĐT",
            "content": "Nội dung này phân tích các loại rủi ro thường gặp trong TMĐT như rủi ro về giao dịch, dữ liệu, pháp lý và uy tín. Bài học đánh giá mức độ ảnh hưởng của chúng đến các bên liên quan. Nhận diện rủi ro là bước đầu tiên để quản lý chúng.",
            "alpha_base": 18
        },
        {
            "id": "c4.3",
            "parent_macro": "m4",
            "title": "Ảnh hưởng của rủi ro trong TMĐT",
            "content": "Bài học đánh giá tác động tiêu cực của các rủi ro an ninh thông tin lên doanh nghiệp, người tiêu dùng và toàn bộ hệ thống TMĐT. Các ảnh hưởng bao gồm thiệt hại tài chính, mất niềm tin và suy giảm uy tín. Nắm rõ ảnh hưởng giúp nhấn mạnh tầm quan trọng của an ninh.",
            "alpha_base": 19
        },
        {
            "id": "c4.4",
            "parent_macro": "m4",
            "title": "Một số giải pháp an toàn trên mạng",
            "content": "Bài học giới thiệu các biện pháp kỹ thuật và phi kỹ thuật nhằm bảo đảm an toàn thông tin trong TMĐT. Các giải pháp bao gồm mã hóa dữ liệu, xác thực đa yếu tố và chính sách bảo mật. Sinh viên sẽ biết cách áp dụng các giải pháp này vào thực tế.",
            "alpha_base": 22
        },
        {
            "id": "c5.1",
            "parent_macro": "m5",
            "title": "Khái niệm hệ thống TMĐT và phát triển hệ thống TMĐT Doanh nghiệp",
            "content": "Bài học trình bày khái niệm về hệ thống TMĐT và các giai đoạn phát triển hệ thống này trong một doanh nghiệp. Nêu rõ các yếu tố cần xem xét khi xây dựng một hệ thống TMĐT hiệu quả. Sinh viên sẽ hiểu được quy trình và các thách thức trong việc phát triển hệ thống.",
            "alpha_base": 18
        },
        {
            "id": "c5.2",
            "parent_macro": "m5",
            "title": "Lập kế hoạch kinh doanh điện tử",
            "content": "Nội dung này giới thiệu các khái niệm cơ bản về kế hoạch kinh doanh điện tử. Bài học phân tích các nội dung chính cần có trong một kế hoạch, từ phân tích môi trường đến chiến lược triển khai. Sinh viên sẽ được trang bị kỹ năng lập kế hoạch kinh doanh chi tiết trong môi trường số.",
            "alpha_base": 25
        }
    ],
